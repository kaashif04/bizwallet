# Copy to .env.local and fill with your project's values
# (Supabase dashboard -> Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# New publishable key (replaces the legacy anon key). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only secret key (replaces the legacy service_role key).
# Used for trusted server actions like top_up_wallet(). NEVER prefix NEXT_PUBLIC.
SUPABASE_SECRET_KEY=sb_secret_xx

# Comma-separated emails allowed to use /admin/setup (the Super Admin page).
SUPER_ADMIN_EMAILS=you@example.com

# Shared secret the physical POS sends to /api/pos/v1/* (e.g. openssl rand -hex 32)
POS_API_KEY=replace-with-a-long-random-secret
